# Overrides for the local docker compose stack. Copy to .env only if the defaults
# below do not suit you — `docker compose up` works without this file.

# Published ports on the host
HTTP_PORT=8080
POSTGRES_PORT=5433
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Postgres credentials (compose builds DATABASE_URL for the backend from them)
POSTGRES_USER=allstore
POSTGRES_PASSWORD=allstore
POSTGRES_DB=allstore

# MinIO credentials — become the backend's S3 keys
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=allstore-dev

# Backend
# минимум 32 символа, иначе backend не стартует
SECRET_KEY=dev-secret-change-me-not-for-production
BASE_DOMAIN=allstore.localhost
LOG_LEVEL=INFO
# subdomains a seller cannot take; empty keeps the built-in list
RESERVED_SUBDOMAINS=

# первый администратор: без них `scripts.bootstrap_admin` не заведёт никого
ADMIN_EMAIL=admin@allstore.localhost
ADMIN_PASSWORD=change-me-before-the-first-deploy

# Transactional mail. Gmail wants an App Password, not the account password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
# Leave SMTP_HOST empty and letters go to the backend log instead of the wire.
SMTP_HOST=smtp.gmail.com
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
# Gmail rewrites this to the account that authenticated, so keep the two the same
MAIL_FROM=you@gmail.com
