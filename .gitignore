# secrets and local environment
.env
.env.*
!.env.example
infra/env/*.env
!infra/env/*.env.example
# the https stand's certificate: generated per machine, never shared
infra/tls/*.crt
infra/tls/*.key
# an empty mountpoint docker leaves behind: the https override mounts a file into conf.d,
# and conf.d is itself a bind mount, so the target appears here. nginx reads it as nothing.
infra/nginx/conf.d/allstore-tls.conf

# python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
# два прогона пишут свои файлы, которые потом объединяются, — см. цель coverage-back
.coverage.*
coverage.xml
htmlcov/

# node / next
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
coverage/

