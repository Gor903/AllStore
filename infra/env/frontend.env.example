# Frontend environment — full list of variables src/lib/env.ts reads.
# In local dev compose supplies these values; copy this file to frontend/.env.local
# only when running `npm run dev` outside docker.

# server-side (SSR) API base URL — the backend service inside the docker network
INTERNAL_API_URL=http://localhost:8000

# browser-facing API base URL — must be reachable from the user's browser
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BASE_DOMAIN=allstore.localhost

# public address of the site, used for canonical links, Open Graph and the sitemap
# defaults to https://<NEXT_PUBLIC_BASE_DOMAIN> when unset
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# cookie names must match access_cookie_name / csrf_cookie_name in the backend settings
NEXT_PUBLIC_ACCESS_COOKIE=allstore_access
NEXT_PUBLIC_CSRF_COOKIE=allstore_csrf
