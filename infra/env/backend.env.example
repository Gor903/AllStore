# Backend environment — full list of variables app/core/config.py validates at startup.
# In local dev compose supplies these values; copy this file to backend/.env only when
# running the backend outside docker, and use it as the checklist for staging/production.

# local | staging | production
APP_ENV=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Sign secret for tokens/sessions: at least 32 characters, unique per environment
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-32+
BASE_DOMAIN=allstore.localhost
# comma-separated list, empty disables CORS middleware
CORS_ORIGINS=http://localhost:8080
# subdomains a seller cannot take; unset keeps DEFAULT_RESERVED_SUBDOMAINS from app/core/config.py
# RESERVED_SUBDOMAINS=www,api,admin,dashboard

# async driver is required (postgresql+asyncpg), host is `postgres` inside compose
DATABASE_URL=postgresql+asyncpg://allstore:allstore@localhost:5433/allstore
DB_ECHO=false
DB_POOL_SIZE=5

# S3-compatible storage: MinIO locally, S3 or equivalent in production
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=allstore-dev
# public base URL for uploaded files, empty falls back to the endpoint above
S3_PUBLIC_URL=http://localhost:9000/allstore-dev
MAX_UPLOAD_SIZE_MB=5

# semantic search service (docs/rag-first.md); empty disables it and the catalogue
# searches by words only — the site does not depend on the service being up
SEARCH_SERVICE_URL=http://search:8000
SEARCH_TIMEOUT_SECONDS=2.0
SEARCH_CANDIDATES=20

# assistant (docs/rag-first.md, раздел 26): any OpenAI-compatible endpoint with tool
# calling — a local Ollama on the stand, a hosted provider later. Empty disables it.
ASSISTANT_BASE_URL=http://ollama:11434/v1
ASSISTANT_MODEL=qwen2.5:3b
# only hosted endpoints need a key; a local model has none
# ASSISTANT_API_KEY=
ASSISTANT_TIMEOUT_SECONDS=120
ASSISTANT_MAX_TOOL_ROUNDS=4
