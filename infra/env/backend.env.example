# Backend environment — full list of variables app/core/config.py validates at startup.
# In local dev compose supplies these values; copy this file to backend/.env only when
# running the backend outside docker, and use it as the checklist for staging/production.

# local | staging | production
APP_ENV=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Sign secret for tokens/sessions: at least 32 characters, unique per environment
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-32+
BASE_DOMAIN=allstore.localhost
# comma-separated list, empty disables CORS middleware
CORS_ORIGINS=http://localhost:8080
# subdomains a seller cannot take; unset keeps DEFAULT_RESERVED_SUBDOMAINS from app/core/config.py
# RESERVED_SUBDOMAINS=www,api,admin,dashboard
# Addresses whose X-Forwarded-For the platform believes — the proxy in front, and nothing
# else. Empty means believe nobody, which is right only when nothing stands in front: behind
# a proxy it leaves every visitor sharing one rate-limit bucket. See app/core/client_ip.py.
TRUSTED_PROXIES=172.16.0.0/12

# The first administrator, read once by `python -m scripts.bootstrap_admin` and never again:
# after that the database is the authority on who administers the platform. The password is a
# secret like any other — keep it in the secret store, not in a committed file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-the-first-deploy

# async driver is required (postgresql+asyncpg), host is `postgres` inside compose
DATABASE_URL=postgresql+asyncpg://allstore:allstore@localhost:5433/allstore
DB_ECHO=false
DB_POOL_SIZE=5

# How many passwords may be hashed at the same time. Each costs ARGON2_MEMORY_COST (19 MiB by
# default), so this is the ceiling on what a flood of logins can ask the machine for.
ARGON2_MAX_PARALLEL=4

# Sessions (docs/adr/0018-server-side-sessions.md, which revises ADR 1). Two clocks: the
# sliding one asks whether the person is still around, the absolute one ends a session
# however busy it is. A session bound to a device key gets the longer absolute life.
SESSION_IDLE_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
SESSION_BOUND_ABSOLUTE_TTL_DAYS=180
# how old a token may get before it is swapped for a fresh one in the same family; this is
# what makes a stolen copy detectable, not what keeps anybody signed in
SESSION_RENEW_AFTER_MINUTES=60
# how long proving the password again buys, for the admin actions that ask for it twice
STEP_UP_TTL_MINUTES=10

# S3-compatible storage: MinIO locally, S3 or equivalent in production
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=allstore-dev
# public base URL for uploaded files, empty falls back to the endpoint above
S3_PUBLIC_URL=http://localhost:9000/allstore-dev
MAX_UPLOAD_SIZE_MB=5

# semantic search service (docs/rag-first.md); empty disables it and the catalogue
# searches by words only — the site does not depend on the service being up
SEARCH_SERVICE_URL=http://search:8000
SEARCH_TIMEOUT_SECONDS=2.0
SEARCH_CANDIDATES=20

# assistant (docs/rag-first.md, раздел 26): any OpenAI-compatible endpoint with tool
# calling — a local Ollama on the stand, a hosted provider later. Empty disables it.
ASSISTANT_BASE_URL=http://ollama:11434/v1
ASSISTANT_MODEL=qwen2.5:3b
# only hosted endpoints need a key; a local model has none
# ASSISTANT_API_KEY=
ASSISTANT_TIMEOUT_SECONDS=120
ASSISTANT_MAX_TOOL_ROUNDS=4
